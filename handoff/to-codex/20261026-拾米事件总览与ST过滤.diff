+
+  // ===== Helpers =====
+function $(id) { return document.getElementById(id); }
+function fmt(n, d=2) { return Number.isFinite(n) ? n.toLocaleString('zh-CN', {minimumFractionDigits:d,maximumFractionDigits:d}) : '--'; }
+function cls(v) { return v > 0 ? 'up' : (v < 0 ? 'down' : ''); }
+function arrow(v) { return Number.isFinite(v) ? (v > 0 ? '▲' : (v < 0 ? '▼' : '—')) : '?'; }
+function changeLabel(v) { return Number.isFinite(v) ? arrow(v)+' '+Math.abs(v).toFixed(2)+'%' : '--'; }
+function esc(v) { return String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
+
+// ===== Clock =====
+function updateClock() {
+  $('clock').textContent = new Date().toLocaleTimeString('zh-CN', {hour12:false});
+}
+updateClock(); setInterval(updateClock, 1000);
+
+// ===== Fetch =====
+async function fetchJSON(url, opts) {
+  const r = await fetch(url, opts || {});
+  if (!r.ok) {
+    let detail = null;
+    try { detail = await r.json(); } catch(e) {}
+    const err = new Error(r.status === 403
+      ? '模块未启用或数据源未接通；没有在后台扫描'
+      : ((detail && (detail.message || detail.error)) || ('请求失败：HTTP '+r.status)));
+    err.status = r.status;
+    throw err;
+  }
+  return r.json();
+}
+
+function moduleUnavailable(ids, error) {
+  const message = (error && error.message) || '数据源未接通；没有在后台扫描';
+  ids.forEach(id => {
+    const el = $(id); if (!el) return;
+    if (id === 'dataSourceLabel') {
+      setAshareSourceLabel('A股 · 数据未取得：' + message);
+      return;
+    }
+    if (id === 'indicesRow') {
+      el.querySelectorAll('.idx-card').forEach(card => { card.innerHTML='<div class="idx-label">数据未取得</div><div class="idx-price">--</div>'; });
+      el.title=message; return;
+    }
+    if (el.tagName === 'TBODY') {
