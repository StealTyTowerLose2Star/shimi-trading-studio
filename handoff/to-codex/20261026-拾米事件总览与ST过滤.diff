+async function loadPlan1W() {
+  const tbodyA = document.getElementById('plan1wActiveBody');
+  const tbodyC = document.getElementById('plan1wClosedBody');
+  if (!tbodyA || !tbodyC) return; // This optional panel is absent from the local demo.
+  try {
+    const data = await fetchJSON('/api/plan-1w/summary');
+    const activeCount = data.active_count || 0;
+    document.getElementById('plan1wActiveCount').textContent = activeCount + '个活跃';
+
+    // Summary cards
+    const totalCost = data.total_cost || 0;
+    const totalMarket = (data.active_plans || []).reduce((s, p) => s + (p.market_value || 0), 0);
+    document.getElementById('plan1wCostMarket').textContent = '¥' + fmt(totalCost, 0) + ' / ¥' + fmt(totalMarket, 0);
+    document.getElementById('plan1wCostSub').textContent = '成本 / 市值';
+
+    const pnl = data.total_active_pnl || 0;
+    const pnlPct = data.total_active_pnl_pct || 0;
+    const pnlEl = document.getElementById('plan1wPnl');
+    const pnlPctEl = document.getElementById('plan1wPnlPct');
+    pnlEl.textContent = (pnl >= 0 ? '+' : '') + '¥' + fmt(pnl, 0);
+    pnlEl.className = 'value ' + (pnl >= 0 ? 'pnl-positive' : 'pnl-negative');
+    pnlPctEl.textContent = (pnlPct >= 0 ? '+' : '') + fmt(pnlPct, 2) + '%';
+    pnlPctEl.className = 'sub ' + (pnlPct >= 0 ? 'pnl-positive' : 'pnl-negative');
+
+    const wr = data.win_rate;
+    document.getElementById('plan1wWinRate').textContent = wr != null ? fmt(wr, 1) + '%' : '--';
+    document.getElementById('plan1wWinSub').textContent = '已平仓交易';
+
+    // Active plans table (+ drafts)
+    const activePlans = data.active_plans || [];
+    const drafts = activePlans.filter(p => p.status === 'draft');
+    const active = activePlans.filter(p => p.status === 'active');
+
+    document.getElementById('plan1wActiveCount').textContent =
+      (drafts.length ? drafts.length + '草稿 · ' : '') + active.length + '活跃';
+
+    const allRows = [
+      ...drafts.map(p => renderPlanRow(p, true)),
+      ...active.map(p => renderPlanRow(p, false)),
+    ];
+
+    if (allRows.length === 0) {
+      tbodyA.innerHTML = '<tr><td colspan="12" style="text-align:center;color:var(--text-muted)">暂无持仓 — 点击「生成新方案」从翻倍股扫描创建</td></tr>';
+    } else {
+      tbodyA.innerHTML = allRows.join('');
+    }
+
+    // Closed plans table
+    const closedPlans = data.closed_plans || [];
+    if (closedPlans.length === 0) {
+      tbodyC.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--text-muted)">暂无平仓记录</td></tr>';
+    } else {
+      tbodyC.innerHTML = closedPlans.map(p => {
+        const pnlVal = p.pnl || 0;
+        const pnlPctVal = p.pnl_pct || 0;
+        const pnlClass = pnlVal >= 0 ? 'pnl-positive' : 'pnl-negative';
+        return '<tr>' +
+          '<td style="font-weight:600;font-size:11px">' + (p.code || '') + '</td>' +
+          '<td style="font-size:12px">' + (p.name || '') + '</td>' +
+          '<td class="code-num">¥' + fmt(p.buy_price, 2) + '</td>' +
+          '<td class="code-num">¥' + fmt(p.close_price, 2) + '</td>' +
+          '<td class="code-num">' + (p.shares || 0) + '</td>' +
+          '<td class="code-num ' + pnlClass + '">' + (pnlVal >= 0 ? '+' : '') + '¥' + fmt(pnlVal, 0) + '</td>' +
+          '<td class="code-num ' + pnlClass + '">' + (pnlPctVal >= 0 ? '+' : '') + fmt(pnlPctVal, 2) + '%</td>' +
+          '<td style="font-size:11px;color:var(--text-secondary)">' + (p.close_reason || '--') + '</td>' +
+        '</tr>';
+      }).join('');
+    }
+  } catch(e) {
+    console.error('loadPlan1W error:', e);
+    tbodyA.innerHTML = '<tr><td colspan="12" style="text-align:center;color:var(--red)">加载失败: ' + e.message + '</td></tr>';
+    tbodyC.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--red)">加载失败</td></tr>';
+  }
+}
+
+async function generatePlan() {
+  if (!confirm('将替换当前所有方案（旧方案标记为已平仓），\n生成最新的市场最强3只，确定吗？')) return;
+  const btn = event.target;
+  btn.disabled = true;
+  btn.textContent = '⏳ 生成中...';
+  try {
+    const r = await fetch(API + '/api/plan-1w', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ generate: true })
+    });
+    const data = await r.json();
+    if (!r.ok) throw new Error(data.error || '生成失败');
+    const msg = '✅ 已生成 ' + (data.created || 0) + ' 只新股' + (data.replaced ? ' (替换 ' + data.replaced + ' 只旧方案)' : '');
+    alert(msg);
+    loadPlan1W();
+  } catch(e) {
+    alert('❌ 生成失败: ' + e.message);
+  } finally {
+    btn.disabled = false;
+    btn.textContent = '📋 生成新方案';
+  }
+}
+
+async function refreshPlanPrices() {
+  await loadPlan1W();
+}
+
+async function closePlan(id) {
+  const closePrice = prompt('请输入平仓价格:');
+  if (!closePrice || isNaN(parseFloat(closePrice))) return;
+  const reason = prompt('请输入平仓原因 (如: 止盈/止损/到期):', '止盈');
+  if (!reason) return;
+
+  try {
+    const r = await fetch(API + '/api/plan-1w/' + id + '/close', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ close_price: parseFloat(closePrice), reason: reason })
+    });
+    const data = await r.json();
+    if (!r.ok) throw new Error(data.error || '平仓失败');
+    alert('✅ 平仓成功！');
+    loadPlan1W();
+  } catch(e) {
+    alert('❌ 平仓失败: ' + e.message);
+  }
+}
+// ─── SSE 实时推送 ─────────────────────────────
+(function() {
+  if(document.getElementById('shimi-mock-banner')) return; // Local mode has no push service.
+  try {
+    const es = new EventSource('/api/sse/stream');
+    es.onmessage = function(e) {
+      try {
+        const msg = JSON.parse(e.data);
+        if (msg.type === 'alert') {
+          showToast(msg.data.message || '系统告警', msg.data.level || 'warning');
+        } else if (msg.type === 'health_update') {
+          const deps = msg.data.deps || {};
+          const status = deps.overall === 'healthy' ? '✅' : deps.overall === 'degraded' ? '⚠️' : '❌';
+          const el = document.getElementById('dataSourceLabel');
+          if (el && !el.textContent.startsWith('A') && !el.textContent.startsWith('🌊')) {
+            // Only update if not showing A-stock/US label
+          }
+        }
+      } catch(_) {}
+    };
+    es.onerror = function() {
+      // 连接断开,30s后自动重连 (EventSource默认行为)
+    };
+  } catch(_) {
+    // SSE not supported, fallback to polling
+  }
+})();
+
+// ===== 📰 美股面板市场事件 =====
+async function loadUSMarketEvents() {
+  try {
+    var data = await fetchJSON('/api/market/events');
+    var usSignals = (data.signals || []).filter(function(s) {
+      return (s.event.market || '') === 'US' || (s.event.source || '') === 'yfinance';
+    });
+    var yf = (data.sources_status || {}).yfinance || {};
+    $('usMarketEventsCount').textContent = usSignals.length + '条美股信号';
+    $('usMETotal').textContent = usSignals.length;
+    $('usMELong').textContent = usSignals.filter(function(s) { return (s.stocks||[])[0] && s.stocks[0].direction === 'long'; }).length;
+    $('usMEShort').textContent = usSignals.filter(function(s) { return (s.stocks||[])[0] && s.stocks[0].direction === 'short'; }).length;
+    $('usMEYf').textContent = (yf.count || 0) + '条';
+    var tbody = $('usMarketEventsBody');
+    if (!usSignals.length) {
+      tbody.innerHTML = '<tr><td colspan=\"7\" style=\"text-align:center;color:var(--text-muted)\">暂无美股信号</td></tr>';
+    } else {
+      tbody.innerHTML = renderSignalRows(usSignals);
+    }
+  } catch(e) {
+    moduleUnavailable(['usMarketEventsCount','usMarketEventsBody'],e);
+  }
+}
+
+// 提取复用：信号行渲染
+function renderSignalRows(signals) {
+  var tc = { '政策驱动':'#f0b429', '财报窗口':'#22c55e', '宏观数据':'#3b82f6', '地缘事件':'#ef4444', '行业动态':'#8b5cf6', '商品价格':'#06b6d4' };
+  var tn = { 'policy':'政策', 'earnings':'财报', 'macro':'宏观', 'geopolitical':'地缘', 'sector':'行业', 'commodity':'商品' };
+  return signals.map(function(sig) {
+    var evt = sig.event || {}, sts = sig.stocks || [];
+    var etype = evt.type || '其他', typeName = tn[etype] || etype;
+    var impact = evt.impact || 'medium';
+    var impColor = impact === 'high' ? 'var(--red)' : (impact === 'medium' ? 'var(--gold)' : 'var(--text-secondary)');
+    var impLabel = impact === 'high' ? '⚠高' : (impact === 'medium' ? '中' : '低');
+    var date = (evt.date || '').slice(5) || '--';
+    if (evt.time) date += ' ' + evt.time;
+    var title = (evt.title || '--').slice(0, 55);
+    var stockText = sts.slice(0, 3).map(function(st) {
+      var d = st.direction === 'short' ? '\ud83d\udcc9' : '\ud83d\udcc8';
+      return '<span style="font-size:10px;margin-right:4px">' + d + ' ' + (st.code || st) + '</span>';
+    }).join('');
+    var dir = sts[0] ? sts[0].direction : 'long';
+    var dirIcon = dir === 'short' ? '\u{1F4C9}' : '\u{1F4C8}';
+    var dirColor = dir === 'short' ? 'var(--red)' : 'var(--green)';
+    return '<tr>' +
+      '<td style="font-size:11px;color:var(--text-muted);white-space:nowrap">' + date + '</td>' +
+      '<td><span style=\"font-size:10px;padding:1px 6px;border-radius:3px;background:' + (tc[typeName]||'#8b5cf6') + '15;color:' + (tc[typeName]||'#8b5cf6') + '\">' + typeName + '</span></td>' +
+      '<td style="font-size:12px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + (evt.title||'').replace(/"/g,'&quot;') + '">' + title + '</td>' +
+      '<td><span style="color:' + impColor + ';font-weight:600;font-size:11px">' + impLabel + '</span></td>' +
+      '<td style=\"color:' + dirColor + ';font-size:11px;font-weight:600\">' + dirIcon + '</td>' +
+      '<td style=\"font-size:11px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">' + (stockText || '--') + '</td>' +
+      '<td style="font-size:11px;color:var(--text-muted)">' + (evt.duration_days || '?') + '天</td>' +
+    '</tr>';
+  }).join('');
+}
+</script>
+</body>
+</html>
