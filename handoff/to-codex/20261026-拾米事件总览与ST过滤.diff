+
+async function renderCalendar() {
+  document.getElementById('calMonthLabel').textContent = calYear + '年' + String(calMonth).padStart(2,'0') + '月';
+  const grid = document.getElementById('calGrid');
+  grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:30px">加载中...</div>';
+
+  // Get day-level P&L data
+  let dayData = {};
+  try {
+    const d = await fetchJSON('/api/trades/pnl-report?period=day', {headers: apiHeaders()});
+    const items = d.report || [];
+    items.forEach(item => { dayData[item.period] = item; });
+  } catch(e) {
+    grid.textContent = e.message;
+    ['calTradeCount','calWinCount','calLossCount'].forEach(id=>{if($(id))$(id).textContent='--';});
+    return;
+  }
+
+  // Build calendar grid
+  const firstDay = new Date(calYear, calMonth - 1, 1);
+  const lastDay = new Date(calYear, calMonth, 0);
+  const startDow = firstDay.getDay(); // 0=Sun
+  const daysInMonth = lastDay.getDate();
+  const today = new Date();
+  const isCurrentMonth = today.getFullYear() === calYear && today.getMonth() + 1 === calMonth;
+
+  let cells = '';
+  let totalTrades = 0, totalWon = 0, totalLoss = 0, totalPnl = 0;
+
+  // Empty cells before first day
+  for (let i = 0; i < startDow; i++) {
+    cells += '<div style="min-height:50px"></div>';
+  }
+
+  for (let d = 1; d <= daysInMonth; d++) {
+    const dateStr = calYear + '-' + String(calMonth).padStart(2,'0') + '-' + String(d).padStart(2,'0');
+    const dayInfo = dayData[dateStr];
+    const hasTrade = !!dayInfo;
+    const pnl = dayInfo ? dayInfo.pnl : 0;
+    const isToday = isCurrentMonth && d === today.getDate();
+
+    if (hasTrade) {
+      totalTrades += dayInfo.trades;
+      if (dayInfo.won > 0) totalWon += dayInfo.won;
+      if (dayInfo.trades - dayInfo.won > 0) totalLoss += (dayInfo.trades - dayInfo.won);
+      totalPnl += pnl;
+    }
+
+    const bg = hasTrade ? (pnl > 0 ? 'rgba(34,197,94,.15)' : pnl < 0 ? 'rgba(239,68,68,.15)' : 'rgba(255,255,255,.03)') : 'transparent';
+    const border = isToday ? '1px solid var(--gold)' : '1px solid transparent';
+    const pnlText = hasTrade ? (pnl >= 0 ? '+' : '') + '¥' + pnl.toFixed(0) : '';
+    const pnlColor = hasTrade ? (pnl > 0 ? 'var(--green)' : pnl < 0 ? 'var(--red)' : 'var(--text-muted)') : '';
+
+    cells += `<div style="min-height:50px;background:${bg};border:${border};border-radius:6px;padding:3px;text-align:center;position:relative">
+      <div style="font-size:11px;font-weight:${isToday?'700':'400'};color:${isToday?'var(--gold)':'var(--text-secondary)'}">${d}</div>
+      ${hasTrade ? `<div style="font-size:9px;font-weight:600;color:${pnlColor};line-height:1.2">${pnlText}</div>` : ''}
+    </div>`;
+  }
+
+  grid.innerHTML = cells || '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:20px">暂无数据</div>';
+
+  document.getElementById('calTradeCount').textContent = totalTrades;
+  document.getElementById('calWinCount').textContent = totalWon;
+  document.getElementById('calLossCount').textContent = totalLoss;
+  const el = document.getElementById('calPnlTotal');
+  el.textContent = (totalPnl >= 0 ? '+' : '') + '¥' + totalPnl.toFixed(2);
+  el.style.color = totalPnl >= 0 ? 'var(--green)' : 'var(--red)';
+}
