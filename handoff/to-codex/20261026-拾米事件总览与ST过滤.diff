+async function closeAllByCode(code) {
+  // 按标的合并平仓：支持部分平仓
+  const trades = serverTrades.filter(t => !t.exit_price && t.code === code);
+  if (trades.length === 0) { alert('无持仓'); return; }
+  const totalQty = trades.reduce((s, t) => s + (t.qty || 0), 0);
+  const name = trades[0].name || code;
+  const qtyInput = prompt(`平仓 (${code} ${name})\n总持仓: ${totalQty}股 (${trades.length}笔)\n输入平仓数量 (留空=全部平仓)：`, '');
+  if (qtyInput === null) return;
+  let exitQty = totalQty;
+  if (qtyInput.trim() !== '') {
+    exitQty = parseInt(qtyInput);
+    if (isNaN(exitQty) || exitQty <= 0 || exitQty > totalQty) { alert(`无效数量 (1-${totalQty})`); return; }
+  }
+  const price = prompt(`平仓价 (${code} ${name})：`, '');
+  if (!price) return;
+  const exitPrice = parseFloat(price);
+  if (isNaN(exitPrice) || exitPrice <= 0) { alert('无效价格'); return; }
+  try {
+    // 按入场批次从早到晚排序，逐批平仓
+    const sorted = [...trades].sort((a, b) => (a.date || '').localeCompare(b.date || ''));
+    let remaining = exitQty;
+    const promises = [];
+    for (const t of sorted) {
+      if (remaining <= 0) break;
+      const batchQty = t.qty || 0;
+      const closeQty = Math.min(batchQty, remaining);
+      promises.push(
+        fetch('/api/trades/' + t.id, {
+          method: 'PUT', headers: apiHeaders(),
+          body: JSON.stringify({exit_price: exitPrice, exit_qty: closeQty})
+        })
+      );
+      remaining -= closeQty;
+    }
+    await Promise.all(promises);
+    loadTradesFromServer();
+  } catch(e) { alert('平仓失败'); }
+}
