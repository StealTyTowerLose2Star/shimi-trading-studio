+  'wallstreetcn':    {a:0.85,u:0.80}, 'sina':            {a:0.80,u:0.75},
+  'jin10':           {a:0.75,u:0.75},
+};
+
+// 事件类别→市场倾向 (A股政策市, 中国政策对美股影响小)
+var CATEGORY_BIAS = {
+  '政策监管':  {a:1.0, u:0.20, note:'中国政策,对美股影响有限'},
+  '财报公告':  {a:1.0, u:0.80, note:'公司级事件,跨市场相关'},
+  '宏观数据':  {a:0.90,u:0.90, note:'全球宏观,双向影响'},
+  '地缘国际':  {a:0.70,u:0.85, note:'国际事件,美股更敏感'},
+  'AI科技':   {a:0.90,u:0.95, note:'全球科技,美股定价权更强'},
+  '新能源':    {a:1.0, u:0.60, note:'中国新能源政策强驱动'},
+  '汽车':     {a:1.0, u:0.70, note:'中国汽车以内需为主'},
+  '半导体':    {a:0.85,u:0.95, note:'全球半导体,美股龙头'},
+  '商品资源':  {a:0.80,u:0.90, note:'全球定价,美股更敏感'},
+  '市场行情':  {a:1.0, u:0.40, note:'本土市场情绪'},
+  '其他':     {a:0.50,u:0.50, note:'未知类别'},
+};
+
+function marketRelevance(signal, market) {
+  // 综合源倾向 + 类别倾向
+  var srcBias = SOURCE_BIAS[signal.source] || {a:0.5, u:0.5};
+  var catBias = CATEGORY_BIAS[signal.category] || CATEGORY_BIAS['其他'];
+  var raw = market === 'ashare'
+    ? (srcBias.a * 0.5 + catBias.a * 0.5)
+    : (srcBias.u * 0.5 + catBias.u * 0.5);
+  return Math.round(raw * 100) / 100;
+}
