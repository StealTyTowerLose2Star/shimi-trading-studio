+          <button onclick="quickLog('${t.code}','${t.name}',${t.entry_price})" style="padding:2px 6px;border:1px solid var(--blue);border-radius:3px;background:transparent;color:var(--blue);cursor:pointer;font-size:11px;margin-left:2px" title="复制">+</button>
