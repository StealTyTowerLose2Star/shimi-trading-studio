+function renderReviewContent(report) {
+  const c = report.content || {};
+  const items = c.items || [];
+  if (items.length === 0) return '<div style="color:var(--text-muted);padding:20px">暂无数据</div>';
+
+  const header = '<div style="font-size:12px;color:var(--text-muted);margin-bottom:10px">生成时间: ' + (report.generated_at || '') + '</div>';
