++// ===== 先知事件信号 (A股/美股独立) =====
++
++// 判断A股代码: 6位数字 00/30/60/68 开头
++function isAStock(code) { return /^[036]0\d{4}$|^68\d{4}$/.test(code); }
++// 判断美股: 1-5个大写字母
++function isUSStock(code) { return /^[A-Z]{1,5}$/.test(code) && !/^\d+$/.test(code); }
++
++// 判断信号属于哪个市场 (至少一个标的在该市场)
++function signalMarket(signal) {
++  const stocks = signal.stocks || [];
++  const hasA = stocks.some(s => isAStock(s.code));
++  const hasUS = stocks.some(s => isUSStock(s.code));
++  if (hasA && !hasUS) return 'ashare';
++  if (hasUS && !hasA) return 'us';
++  if (hasA && hasUS) return 'mixed';
++  return 'unknown';
++}
