++            # purpose_unconfirmed (用途闸门先于令牌读取), 均为显式502而非伪造数据
++            text = body.decode('utf-8')
++            check(status == 502 and ('purpose_unconfirmed' in text or 'TUSHARE_TOKEN' in text),
