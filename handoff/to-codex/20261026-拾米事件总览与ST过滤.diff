++            for ts in active:
++                boards[ts] = None
++            break
++        prev = dict(zip(snap["ts_code"], snap["pct_chg"]))
++        for ts in list(active):
++            v = prev.get(ts)
++            if v is None or pd.isna(v):
++                boards[ts] = None
++                active.remove(ts)
++            elif v >= 9.5:
