++      var filterFn = market === 'ashare' ? isAStock : isUSStock;
++      var stocks = (s.stocks || []).filter(function(st) { return filterFn(st.code); }).slice(0, 3).map(function(st) { return st.code || st; }).join(' ');
++      var relColor = rel >= 0.8 ? 'var(--green)' : (rel >= 0.5 ? 'var(--gold)' : 'var(--text-muted)');
++      var scoreColor = adjScore > 100 ? 'var(--gold)' : (adjScore > 60 ? 'var(--text-primary)' : 'var(--text-muted)');
++      return '<tr>' +
++        '<td style="color:' + dirColor + ';font-weight:700;font-size:11px">' + dirIcon + ' ' + (s.direction === 'long' ? '做多' : '做空') + '</td>' +
++        '<td style="font-size:11px">' + confBadge + '</td>' +
++        '<td style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px" title="' + s.title.replace(/"/g,'&quot;') + '">' + s.title + '</td>' +
++        '<td style="font-size:11px;color:var(--text-secondary)">' + stocks + '</td>' +
