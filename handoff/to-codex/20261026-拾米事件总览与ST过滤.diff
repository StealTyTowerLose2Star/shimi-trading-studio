+      '<span>总计: <strong>' + summary.total + '</strong> 只</span>' +
+      '<span style="color:var(--green)">超预期: <strong>' + (summary.exceed || 0) + '</strong></span>' +
+      '<span style="color:var(--text-secondary)">符合预期: <strong>' + (summary.match || 0) + '</strong></span>' +
+      '<span style="color:var(--red)">不及预期: <strong>' + (summary.miss || 0) + '</strong></span>' +
+      '</div>';
+  }
+
+  const list = items.map(item => {
+    const isDoubler = item.current_price >= item.recommend_price * 2;
+    const pnl = ((item.current_price - item.recommend_price) / item.recommend_price * 100).toFixed(1);
+    const pnlCls = pnl > 0 ? 'up' : 'down';
+    const pnlColor = pnl > 5 ? 'var(--green)' : pnl < -5 ? 'var(--red)' : 'var(--text-secondary)';
+    const tag = isDoubler ? '<span style="padding:1px 6px;border-radius:3px;background:rgba(240,180,41,.2);color:var(--gold);font-size:10px;font-weight:700;margin-left:4px">🚀 翻倍</span>' : '';
+
+    let detailRows = '';
+    if (item.tech_phase) detailRows += '<div style="font-size:11px;color:var(--text-muted)">阶段: ' + item.tech_phase + ' | 均线: ' + (item.ma_alignment || '--') + '</div>';
+    if (item.failure_reason) detailRows += '<div style="font-size:11px;color:var(--red)">原因: ' + item.failure_reason + '</div>';
+    if (item.advice) detailRows += '<div style="font-size:11px;color:var(--gold);margin-top:2px">建议: ' + item.advice + '</div>';
+
+    return '<div style="padding:10px;margin-bottom:8px;background:rgba(255,255,255,.03);border-radius:8px;border-left:3px solid ' + (pnl > 5 ? 'var(--green)' : pnl < -5 ? 'var(--red)' : 'var(--text-muted)') + '">' +
+      '<div style="display:flex;justify-content:space-between;align-items:center">' +
+        '<div><strong>' + item.code + '</strong> ' + (item.name || '') + tag + '</div>' +
+        '<div style="font-weight:700;color:' + pnlColor + '">' + (pnl >= 0 ? '+' : '') + pnl + '%</div>' +
+      '</div>' +
+      '<div style="font-size:11px;color:var(--text-secondary);margin-top:2px">推荐价: ¥' + item.recommend_price + ' → 现价: ¥' + (item.current_price || '--') + '</div>' +
+      detailRows +
+      (item.reason_compare ? '<div style="font-size:11px;color:var(--text-muted);margin-top:2px;padding:4px;background:rgba(255,255,255,.02);border-radius:4px">推荐理由: ' + item.reason_compare + '</div>' : '') +
+    '</div>';
+  }).join('');
+
+  return header + summaryHtml + list;
+}
