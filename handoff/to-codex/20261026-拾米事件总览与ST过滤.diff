+      const t2 = isOpen ? (ev.targets?.[1]?.price ? '¥' + ev.targets[1].price : (t.target_2 || '--')) : '--';
+      const t3 = isOpen ? (ev.targets?.[2]?.price ? '¥' + ev.targets[2].price : '--') : '--';
+      const trailLabels = {0:'初始',1:'保本',2:'锁利',3:'高锁'};
+      const trailLvl = isOpen ? (ev.trailing_level != null ? trailLabels[ev.trailing_level] || ('T'+ev.trailing_level) : '初始') : '--';
+      const pnl = isOpen ? ((ev.unrealized_pnl || 0) * (t.qty || 1)) : (() => {
+        if (!t.exit_price) return '--';
+        return t.direction === 'buy' ? (t.exit_price - t.entry_price) * t.qty : (t.entry_price - t.exit_price) * t.qty;
