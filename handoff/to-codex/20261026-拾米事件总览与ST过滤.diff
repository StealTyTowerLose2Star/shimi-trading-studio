+async function closeServerTrade(id) {
+  // 从服务端数据中查找持仓
+  const t = Array.isArray(serverTrades) ? serverTrades.find(t2 => t2.id === id) : null;
+  if (!t) { alert('交易记录不存在'); return; }
+  const maxQty = t.qty || 0;
+  const input = prompt(`平仓 (${t.code} ${t.name})\n当前持仓: ${maxQty}股\n输入平仓数量 (留空=全部平仓)：`, '');
+  if (input === null) return;
+  let exitQty = maxQty;
+  if (input.trim() !== '') {
+    exitQty = parseInt(input);
+    if (isNaN(exitQty) || exitQty <= 0 || exitQty > maxQty) { alert(`无效数量 (1-${maxQty})`); return; }
+  }
+  const price = prompt(`平仓价 (${t.code} ${t.name})：`, '');
+  if (!price) return;
+  const exitPrice = parseFloat(price);
+  if (isNaN(exitPrice) || exitPrice <= 0) { alert('无效价格'); return; }
+  try {
+    await fetch('/api/trades/' + id, {
+      method: 'PUT', headers: apiHeaders(),
+      body: JSON.stringify({exit_price: exitPrice, exit_qty: exitQty})
+    });
+    loadTradesFromServer();
+  } catch(e) { alert('平仓失败'); }
+}
