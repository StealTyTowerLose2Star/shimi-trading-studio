+
+    const r2 = await fetch('/api/positions/realtime', {
+      method: 'POST', headers: apiHeaders(),
+      body: JSON.stringify({codes: openCodes})
+    });
+    const prices = (await r2.json()).prices || {};
+
+    // 逐行更新：价格 + 浮盈(¥ + %)
+    let updated = 0;
+    document.querySelectorAll('#tradeJournalBody tr').forEach(tr => {
+      const codeCell = tr.querySelector('td:nth-child(2)');
+      if (!codeCell) return;
+      const code = codeCell.textContent.trim();
+      const info = prices[code];
+      if (!info || info.price == null) return;
+
+      // 更新当前价
+      const priceCell = tr.querySelector('td:nth-child(7)');
+      const newPrice = info.price;
+      if (priceCell) priceCell.textContent = '¥' + newPrice;
+
+      // 逐批计算浮盈（合并行）
+      const openBatch = trades.filter(t => !t.exit_price && t.code === code);
+      if (openBatch.length === 0) return;
+      const totalCost = openBatch.reduce((s, t) => s + (t.entry_price || 0) * (t.qty || 0), 0);
+      const pnl = openBatch.reduce((s, t) => s + (newPrice - t.entry_price) * (t.qty || 0), 0);
