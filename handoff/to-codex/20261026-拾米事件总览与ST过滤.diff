++        df = index_data.get(name)
++        if df is not None and len(df) >= 25:
++            cur = df["amount"].iloc[-1]
++            avg = df["amount"].tail(20).mean()
++            if cur > 0 and avg > 0:
++                vol_ratio += (cur / avg) * w
++            elif cur == 0 and avg > 0:
