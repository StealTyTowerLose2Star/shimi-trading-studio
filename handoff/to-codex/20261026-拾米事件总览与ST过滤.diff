+async function activatePlan(id) {
+  const price = prompt('实际买入价 (留空=使用推荐价):');
+  if (price === null) return;  // cancelled
+  const shares = prompt('实际买入股数 (留空=使用推荐数):');
+  if (shares === null) return;
+
+  const body = {};
+  if (price) body.buy_price = parseFloat(price);
+  if (shares) body.shares = parseInt(shares);
+
+  try {
+    const r = await fetch(API + '/api/plan-1w/' + id + '/activate', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(body)
+    });
+    if (!r.ok) throw new Error(await r.text());
+    alert('✅ 买入确认成功！');
+    loadPlan1W();
+  } catch(e) {
+    alert('❌ 确认失败: ' + e.message);
+  }
+}
