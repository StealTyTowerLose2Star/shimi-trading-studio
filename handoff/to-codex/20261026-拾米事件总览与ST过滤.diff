+
+        eps_ttm = _ttm_from_cumulative([(d, _num(v)) for d, v in eps_rows], "eps")
+        ocf_ttm = _ttm_from_cumulative([(d, _num(v)) for d, v in ocf_rows], "ocfps")
+        bps_latest = next((float(v) for d, v in reversed(bps_rows)
