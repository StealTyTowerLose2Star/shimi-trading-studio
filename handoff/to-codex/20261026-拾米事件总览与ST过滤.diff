++  const deepDives = data.deep_dives || [];
++  const totalEvents = data.total_events || 0;
++  const scanTime = data.timestamp || '';
++
++  // 按市场+影响因子严格过滤
++  // A股面板: 纯A股信号 + 混合信号(影响因子≥0.5) / 排除纯美股
++  // 美股面板: 纯美股信号 + 混合信号(影响因子≥0.5) / 排除纯A股
