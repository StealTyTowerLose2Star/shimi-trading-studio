+async function loadKlineData(code, containerId, days) {
+  var container = document.getElementById(containerId);
+  var loading = document.getElementById('klineLoading');
+  if (!container || !loading) return;
+  try {
+    var r = await fetch('/api/stock/' + code + '/kline?days=' + days);
+    if (!r.ok) throw new Error('HTTP ' + r.status);
+    var d = await r.json();
+    if (d.error) throw new Error(d.error);
+    
+    var dates = d.kline.map(function(k) { return k.date; });
+    var ohlc = d.kline.map(function(k) { return [k.open, k.close, k.low, k.high]; });
+    var volumes = d.kline.map(function(k) { return k.volume; });
+    var closes = d.kline.map(function(k) { return k.close; });
+
+    function calcMA(data, period) {
+      var result = [];
+      for (var i = 0; i < data.length; i++) {
+        if (i < period - 1) { result.push(null); continue; }
+        var sum = 0;
+        for (var j = i - period + 1; j <= i; j++) sum += data[j];
+        result.push(+(sum / period).toFixed(2));
+      }
+      return result;
+    }
+    var ma5 = calcMA(closes, 5);
+    var ma20 = calcMA(closes, 20);
+    var ma60 = calcMA(closes, 60);
+    var ma120 = calcMA(closes, 120);
+    
+var closes = d.kline.map(function(k) { return k.close; });
+    
+    // 计算移动平均线 MA5 / MA20 / MA60 / MA120
+    function calcMA(data, period) {
+      var result = [];
+      for (var i = 0; i < data.length; i++) {
+        if (i < period - 1) { result.push(null); continue; }
+        var sum = 0;
+        for (var j = i - period + 1; j <= i; j++) sum += data[j];
+        result.push(+(sum / period).toFixed(2));
+      }
+      return result;
+    }
+    var ma5 = calcMA(closes, 5);
+    var ma20 = calcMA(closes, 20);
+    var ma60 = calcMA(closes, 60);
+    var ma120 = calcMA(closes, 120);
+
+    
+    // 计算每日涨跌幅: (今日收盘-昨日收盘)/昨日收盘 × 100
+    var changes = [];
+    for (var i = 0; i < ohlc.length; i++) {
+      if (i === 0) { changes.push('--'); continue; }
+      var prevClose = ohlc[i - 1][1]; // 昨日收盘
+      var todayClose = ohlc[i][1];     // 今日收盘
+      var pct = ((todayClose - prevClose) / prevClose * 100);
+      changes.push((pct >= 0 ? '+' : '') + pct.toFixed(2) + '%');
+    }
+    
+    // 复用已有 chart 实例，避免 init/dispose 竞态
+    var chart = container._echart;
+    if (!chart || chart.isDisposed()) {
+      if (chart) chart.dispose();
+      container.innerHTML = '';
+      container.style.display = 'block';
+      chart = echarts.init(container, 'dark');
+      container._echart = chart;
+    }
+    loading.style.display = 'none';
+    
+    // 自定义 tooltip 格式，显示涨跌幅
+    var self = this;
+    chart.setOption({
+      animation: false,
+      tooltip: {
+        trigger: 'axis',
+        axisPointer: { type: 'cross' },
+        formatter: function(params) {
+          var kline = params[0];
+          if (!kline) return '';
+          var idx = kline.dataIndex;
+          var o = ohlc[idx];
+          var chg = changes[idx];
+          var vol = volumes[idx];
+          var color = o[1] >= o[0] ? '#ef4444' : '#22c55e';
+          var arrow = o[1] >= o[0] ? '↑' : '↓';
+          return '<div style="font-size:12px">' +
+            '<strong>' + dates[idx] + '</strong><br>' +
+            '开盘: ' + o[0].toFixed(2) + '<br>' +
+            '收盘: <span style="color:' + color + '">' + o[1].toFixed(2) + '</span><br>' +
+            '最高: ' + o[2].toFixed(2) + '<br>' +
+            '最低: ' + o[3].toFixed(2) + '<br>' +
+            '涨跌: <span style="color:' + color + ';font-weight:700">' + arrow + ' ' + chg + '</span><br>' +
+            '成交量: ' + (vol / 10000).toFixed(1) + '万手' +
+            '</div>';
+        }
+      },
+      grid: [
+        { left: '8%', right: '3%', top: '5%', height: '65%' },
+        { left: '8%', right: '3%', top: '78%', height: '16%' }
+      ],
+      xAxis: [
+        { type: 'category', data: dates, gridIndex: 0, axisLabel: { fontSize: 10 } },
+        { type: 'category', data: dates, gridIndex: 1, axisLabel: { show: false } }
+      ],
+      yAxis: [
+        { type: 'value', gridIndex: 0, scale: true, splitLine: { lineStyle: { color: '#333' } } },
+        { type: 'value', gridIndex: 1, axisLabel: { show: false }, splitLine: { show: false } }
+      ],
+      series: [
+        {
+          name: 'K线', type: 'candlestick', xAxisIndex: 0, yAxisIndex: 0,
+          data: ohlc,
+          itemStyle: { color: '#ef4444', color0: '#22c55e', borderColor: '#ef4444', borderColor0: '#22c55e' }
+        },
+        {
+          name: '成交量', type: 'bar', xAxisIndex: 1, yAxisIndex: 1,
+          data: volumes,
+          itemStyle: { color: function(p) { return ohlc[p.dataIndex][1] >= ohlc[p.dataIndex][0] ? '#ef4444' : '#22c55e'; } }
+        },
+        {
+          name: 'MA5', type: 'line', xAxisIndex: 0, yAxisIndex: 0,
+          data: ma5, symbol: 'none', lineStyle: { color: '#f59e0b', width: 1, type: 'solid' },
+          silent: true
+        },
+        {
+          name: 'MA20', type: 'line', xAxisIndex: 0, yAxisIndex: 0,
+          data: ma20, symbol: 'none', lineStyle: { color: '#8b5cf6', width: 1, type: 'solid' },
+          silent: true
+        },
+        {
+          name: 'MA60', type: 'line', xAxisIndex: 0, yAxisIndex: 0,
+          data: ma60, symbol: 'none', lineStyle: { color: '#06b6d4', width: 1.5, type: 'dashed' },
+          silent: true
+        },
+        {
+          name: 'MA120', type: 'line', xAxisIndex: 0, yAxisIndex: 0,
+          data: ma120, symbol: 'none', lineStyle: { color: '#ef4444', width: 1, type: 'dotted' },
+          silent: true
+        }
+      ]
+    });
+    window.addEventListener('resize', function() { chart.resize(); });
+  } catch(e) {
+    loading.textContent = '⏳ K线数据获取中…';
+    loading.style.color = '#f0b429';
+  }
+}
