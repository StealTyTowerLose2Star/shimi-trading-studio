+# ─── 指数行情 / 指数历史 ─────────────────────────────────────
+
+INDEX_MAP = {  # 与原 data/fetcher_indices.py 一致
+    "000001.SH": "上证指数",
+    "399001.SZ": "深证成指",
+    "399006.SZ": "创业板指",
