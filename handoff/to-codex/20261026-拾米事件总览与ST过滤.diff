+}
+
+function updateTradeStats(trades) {
+  const closed = trades.filter(t => t.exit_price);
+  const won = closed.filter(t => {
+    const pnl = t.direction === 'buy' ? (t.exit_price - t.entry_price) * t.qty : (t.entry_price - t.exit_price) * t.qty;
+    return pnl > 0;
+  });
+  const totalPnl = closed.reduce((sum, t) => {
+    const pnl = t.direction === 'buy' ? (t.exit_price - t.entry_price) * t.qty : (t.entry_price - t.exit_price) * t.qty;
+    return sum + pnl;
+  }, 0);
+  const winRate = closed.length > 0 ? (won.length / closed.length * 100).toFixed(1) + '%' : '0%';
+  const bestPnl = closed.length > 0 ? Math.max(...closed.map(t => {
+    return t.direction === 'buy' ? (t.exit_price - t.entry_price) * t.qty : (t.entry_price - t.exit_price) * t.qty;
+  })) : 0;
+  const worstPnl = closed.length > 0 ? Math.min(...closed.map(t => {
+    return t.direction === 'buy' ? (t.exit_price - t.entry_price) * t.qty : (t.entry_price - t.exit_price) * t.qty;
+  })) : 0;
+
+  // 月回报 = 本月所有交易盈亏(含持仓浮动) / 本金 × 100%
+  const now = new Date();
+  const thisMonth = String(now.getMonth() + 1).padStart(2, '0');
+  const thisYear = now.getFullYear();
+  let monthPnl = 0, monthCapital = 0;
+  trades.forEach(t => {
+    const d = t.date || '';
+    if (!d || !d.startsWith(thisYear + '-' + thisMonth)) return;
+    const qty = t.qty || 0;
+    const entry = t.entry_price || 0;
+    monthCapital += entry * qty;
+    if (t.exit_price) {
+      monthPnl += (t.direction === 'buy' ? (t.exit_price - entry) : (entry - t.exit_price)) * qty;
+    }
+  });
+  updateMonthRatio(monthPnl, monthCapital);
+
+  $('tjTotal').textContent = closed.length;
+  $('tjWinRate').textContent = winRate;
+  $('tjWinRate').style.color = parseFloat(winRate) >= 50 ? 'var(--green)' : 'var(--red)';
+  $('tjPnl').textContent = (totalPnl >= 0 ? '+' : '') + '¥' + totalPnl.toFixed(2);
+  $('tjPnl').style.color = totalPnl >= 0 ? 'var(--green)' : 'var(--red)';
+  $('tjBest').textContent = bestPnl > 0 ? '¥' + bestPnl.toFixed(2) : '--';
+  $('tjWorst').textContent = worstPnl < 0 ? '¥' + worstPnl.toFixed(2) : '--';
+  $('tradeJournalStats').textContent = `${trades.length}笔`;
+}
+
+function updateMonthRatio(monthPnl, monthCapital) {
+  const ratio = monthCapital > 0 ? (monthPnl / monthCapital * 100) : null;
+  const el = document.getElementById('tjMonthlyRatio');
+  if (!el) return;
+  el.textContent = ratio !== null ? (ratio >= 0 ? '+' : '') + ratio.toFixed(1) + '%' : '--';
+  el.style.color = ratio !== null ? (ratio >= 0 ? 'var(--green)' : 'var(--red)') : 'var(--text-muted)';
+}
