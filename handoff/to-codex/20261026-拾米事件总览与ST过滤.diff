+let serverTrades = [];
+let serverSummary = {};
+
+function renderServerTrades() {
+  const tbody = document.getElementById('tradeJournalBody');
+  const trades = serverTrades;
+  if (trades.length === 0) {
+    tbody.innerHTML = '<tr><td colspan="13" style="text-align:center;color:var(--text-muted)">暂无交易记录</td></tr>';
+    updateServerStats();
+    return;
+  }
+
+  // Step 1: 拆分持仓和已平仓
+  const openRaw = trades.filter(t => !t.exit_price);
+  const closedTrades = trades.filter(t => t.exit_price);
+
+  // Step 2: 同标的持仓合并
+  const merged = {};
+  openRaw.forEach(t => {
+    const c = t.code;
+    if (!merged[c]) merged[c] = [];
+    merged[c].push(t);
+  });
+
+  const openMerged = Object.values(merged).map(batch => {
+    const totalQty = batch.reduce((s, t) => s + (t.qty || 0), 0);
+    const wAvgEntry = totalQty > 0 ? batch.reduce((s, t) => s + (t.entry_price || 0) * (t.qty || 0), 0) / totalQty : batch[0].entry_price;
+    return {
+      code: batch[0].code,
+      name: batch[0].name,
+      direction: batch[0].direction,
+      entry_price: wAvgEntry,
+      qty: totalQty,
+      date: batch[0].date,
+      count: batch.length,
+      batch: batch,
