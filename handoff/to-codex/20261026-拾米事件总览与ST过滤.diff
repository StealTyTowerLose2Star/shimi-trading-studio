+    "2026-10-21,1312.00,1309.69,1318.00,1305.00,11000,15000000",
+]}}
+
+
+def fake_http_json(url, timeout=10):
+    if "ulist" in url:
+        return ULIST
+    if "m:90+t:2" in url:
+        return BOARDS
+    if "clist" in url:
+        return SNAPSHOT
+    if "kline" in url:
+        return KLINE
