++
++    if vol_ratio >= 2.0:
++        volume_score = 100
++    elif vol_ratio >= 1.5:
++        volume_score = 85
++    elif vol_ratio >= 1.2:
++        volume_score = 70
++    elif vol_ratio >= 0.8:
++        volume_score = 50
++    elif vol_ratio >= 0.5:
++        volume_score = 30
++    else:
++        volume_score = 10
++
++    total_score = (trend_total * 0.40 + pos_total * 0.20 +
++                   sentiment_score * 0.20 + volume_score * 0.20)
++
++    MARKET_STATES = [
++        (85, "强势牛市🚀", "指数多头排列，量价齐升", (80, 100)),
++        (65, "牛市📈", "指数趋势向上，市场活跃", (65, 80)),
