++                          'mode':meta.get('mode'),
++                          'data_backend':meta.get('data_backend'),
++                          'source_verification':meta.get('source_verification'),
++                          'trading_enabled':meta.get('trading_enabled'),
++                          'credential_inheritance':bool(os.environ.get('TUSHARE_TOKEN'))}))
