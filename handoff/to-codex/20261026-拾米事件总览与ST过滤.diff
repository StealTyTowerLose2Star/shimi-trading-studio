+      // 浮动
+      const slCell = tr.querySelector('td:nth-child(12)');
+      if (slCell) { slCell.textContent = (pnl >= 0 ? '+' : '') + '¥' + pnl.toFixed(2); slCell.className = 'code-num ' + (pnl > 0 ? 'up' : pnl < 0 ? 'down' : ''); slCell.style.fontWeight = '700'; }
+
+      // 浮盈%
+      });
+    if (btn) btn.textContent = '✅ 已更新 ' + updated + ' 只';
+    setTimeout(() => { if(btn) btn.textContent = '🔄 实时价'; }, 3000);
+  } catch(e) {
+    if (btn) btn.textContent = '❌ 失败';
