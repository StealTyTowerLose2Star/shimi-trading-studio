+def _is_ip_literal(host) -> bool:
+    if not isinstance(host, str):
+        return False
+    for fam in (socket.AF_INET, socket.AF_INET6):
+        try:
+            socket.inet_pton(fam, host.strip("[]"))
+            return True
+        except (OSError, ValueError):
+            continue
+    return False
