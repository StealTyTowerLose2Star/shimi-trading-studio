+// 缓存全量信号数据 (两个面板共用)
+let _prophetCache = null;
+
+async function loadProphetSignals(market, forceScan) {
+  const prefix = market === 'ashare' ? 'prophetA' : 'prophetUS';
+  
+  try {
+    if (forceScan) {
+      $(prefix + 'SigCount').textContent = '扫描中...';
+      // 直接fetch POST, 避免fetchJSON的GET默认行为
+      await fetch('/api/prophet/event-signals/scan', {method:'POST'});
+      await new Promise(function(r) { setTimeout(r, 2000); });
+    }
+
+    if (!forceScan && _prophetCache) {
+      renderProphetPanel(prefix, _prophetCache, market);
+      return;
+    }
+
+    const data = await fetchJSON('/api/prophet/event-signals');
+    // 如果是空缓存且正在扫描中, 提示用户
+    if (!data.signals || !data.signals.length) {
+      if (forceScan) {
+        $(prefix + 'SigCount').textContent = '扫描中,请10秒后刷新';
+        $(prefix + 'SignalsBody').innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--gold)">⏳ 后台扫描进行中, 约20秒后刷新页面查看</td></tr>';
+        return;
+      }
+      $(prefix + 'SigCount').textContent = '等待扫描';
+      $(prefix + 'SignalsBody').innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-muted)">缓存未就绪, 点击"重新扫描"触发</td></tr>';
+      return;
+    }
+
+    _prophetCache = data;
+    renderProphetPanel(prefix, data, market);
+
+  } catch (err) {
+    console.error('Prophet load error:', err);
+    moduleUnavailable([prefix+'SigCount',prefix+'SignalsBody'],err);
+  }
+}
+
+function renderProphetPanel(prefix, data, market) {
+  const allSignals = data.signals || [];
+  const deepDives = data.deep_dives || [];
+  const totalEvents = data.total_events || 0;
+  const scanTime = data.timestamp || '';
+
+  // 按市场+影响因子严格过滤
+  // A股面板: 纯A股信号 + 混合信号(影响因子≥0.5) / 排除纯美股
+  // 美股面板: 纯美股信号 + 混合信号(影响因子≥0.5) / 排除纯A股
+  const signals = allSignals
+    .filter(s => {
+      const m = signalMarket(s);
+      const rel = marketRelevance(s, market);
+      if (m === market) return true;           // 纯A/纯美, 直接通过
+      if (m === 'mixed' && rel >= 0.5) return true; // 混合信号, 需要影响因子≥50%
+      return false;                            // 其他: 排除
+    })
+    .sort((a, b) => {
+      // 按调整后分数排序 = 原始分 × 影响因子
+      var sa = a.score * marketRelevance(a, market);
+      var sb = b.score * marketRelevance(b, market);
+      return sb - sa;
+    });
+
+  // Summary
+  $(prefix + 'EvtTotal').textContent = totalEvents;
+  $(prefix + 'SigTotal').textContent = signals.length;
+  $(prefix + 'Long').textContent = signals.filter(s => s.direction === 'long').length;
+  $(prefix + 'Short').textContent = signals.filter(s => s.direction === 'short').length;
+  $(prefix + 'High').textContent = signals.filter(s => s.confidence === 'high').length;
+  $(prefix + 'SigCount').textContent = signals.length + '条信号';
+  $(prefix + 'ScanTime').textContent = scanTime || '';
+
+  // Signals table (top 12)
+  const tbody = $(prefix + 'SignalsBody');
+  if (!signals.length) {
+    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-muted)">暂无' + (market === 'ashare' ? 'A股' : '美股') + '信号</td></tr>';
+  } else {
+    tbody.innerHTML = signals.slice(0, 12).map(s => {
+      var rel = marketRelevance(s, market);
+      var adjScore = Math.round(s.score * rel);
+      var dirIcon = s.direction === 'long' ? '📈' : '📉';
+      var dirColor = s.direction === 'long' ? 'var(--green)' : 'var(--red)';
+      var confBadge = s.confidence === 'high' ? '🔥' : (s.confidence === 'medium' ? '⭐' : '');
+      var filterFn = market === 'ashare' ? isAStock : isUSStock;
+      var stocks = (s.stocks || []).filter(function(st) { return filterFn(st.code); }).slice(0, 3).map(function(st) { return st.code || st; }).join(' ');
+      var relColor = rel >= 0.8 ? 'var(--green)' : (rel >= 0.5 ? 'var(--gold)' : 'var(--text-muted)');
+      var scoreColor = adjScore > 100 ? 'var(--gold)' : (adjScore > 60 ? 'var(--text-primary)' : 'var(--text-muted)');
+      return '<tr>' +
+        '<td style="color:' + dirColor + ';font-weight:700;font-size:11px">' + dirIcon + ' ' + (s.direction === 'long' ? '做多' : '做空') + '</td>' +
+        '<td style="font-size:11px">' + confBadge + '</td>' +
+        '<td style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px" title="' + s.title.replace(/"/g,'&quot;') + '">' + s.title + '</td>' +
+        '<td style="font-size:11px;color:var(--text-secondary)">' + stocks + '</td>' +
+        '<td style="font-size:11px;color:' + relColor + ';font-weight:600">' + (rel*100).toFixed(0) + '%</td>' +
+        '<td style="color:' + scoreColor + ';font-weight:600;font-size:12px">' + adjScore + '</td>' +
+        '</tr>';
+    }).join('');
+  }
+
+  // Deep dives — A股面板才显示
+  var ddPrefix = market === 'ashare' ? 'prophetADeepDives' : null;
+  if (ddPrefix) {
+    var ddContainer = $(ddPrefix);
+    if (!deepDives.length) {
+      ddContainer.innerHTML = '<span style="color:var(--text-muted)">暂无定向分析</span>';
+    } else {
+      ddContainer.innerHTML = deepDives.slice(0, 6).map(function(d) {
+        var ddDirColor = d.direction.includes('long') ? 'var(--green)' : 'var(--red)';
+        var ddStocks = (d.stocks || []).slice(0, 3).join(', ');
+        return '<div style="padding:8px 10px;background:rgba(139,92,246,.06);border:1px solid rgba(139,92,246,.15);border-radius:8px;min-width:180px;flex:1">' +
+          '<div style="font-weight:600;color:' + ddDirColor + ';margin-bottom:2px">' + d.signal + '</div>' +
+          '<div style="color:var(--text-muted);margin-bottom:4px;line-height:1.4">' + (d.title ? d.title.slice(0, 60) : '') + '</div>' +
+          '<div style="color:var(--text-secondary)">→ ' + ddStocks + '</div>' +
+          '<div style="color:var(--text-muted);font-size:10px;margin-top:2px">' + (d.duration || '') + '</div>' +
+          '</div>';
+      }).join('');
+    }
+  }
+}
