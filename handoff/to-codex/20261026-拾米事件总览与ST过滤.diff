++    df["name"] = df["ts_code"].map(lambda c: basic.get(c, {}).get("name", ""))
++    boards = {ts: 1 for ts in df["ts_code"]}
++    active = set(boards)
++    if not days or days[0] != d0:
++        raise MarketDataUnavailable("连板统计缺少对应交易日历")
++    for d in days[1:]:
++        if not active:
++            break
++        snap = _daily_snapshot(d)
